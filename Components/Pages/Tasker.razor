@page "/tasker"

<div class="d-flex align-items-center justify-content-center">
    <div class="p-5">
        <div class="p-2 text-center mb-3"
            <img src="/img/floatingCity.png" alt="Floating City" width="300" />
        </div
        <div>  
            <EditForm Model="ti" OnValidSubmit="addTask">
                <div class="d-flex flew-row gap-2">
                    <InputText class="form-control" placeholder="Enter a new task..." @bind-Value="ti.Name"/>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
                <div>
                    <ValidationMessage For="() => ti.Name"></ValidationMessage>
                </div>
            </EditForm>
        </div>
        <hr />
        <div class="vstack">
            @foreach(var lineItem in taskerItems)
            {
                <TaskerLine Item="lineItem"></TaskerLine>
            }

        </div>
    </div>
</div>

@code {
    private TaskerItem ti = new();
    private List<TaskerItem> taskerItems = new();
    
    private void addTask()
    {
        ti.Id = Guid.NewGuid();
        taskerItems.Add(ti);
        ti = new();
    }
}
