@page "/tasker"

<div class="d-flex align-items-center justify-content-center">
    <div class="p-5">
        <div class="p-2 text-center mb-3"
            <img src="/img/floatingCity.png" alt="Floating City" width="300" />
        </div
        <div>  
            <EditForm Model="ti">
                <div class="d-flex flew-row gap-2">
                    <InputText class="form-control" placeholder="Enter a new task..." @bind-Value="ti.Name"/>
                    <button class="btn btn-primary" type="submit">Add</button>
                </div>
            </EditForm>
        </div>
        <hr />
    </div>
</div>

@code {
    private TaskerItem ti = new();
}
